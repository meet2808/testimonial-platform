# Environment Variables — Testimonial Platform Backend
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/testimonial_db

# ─── JWT ──────────────────────────────────────────────────
# Use a long, random string — never commit the real value
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=24h

# ─── CORS ─────────────────────────────────────────────────
# The URL of your frontend (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# ─── File Upload ──────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
